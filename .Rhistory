# Errori:
err$XGBoost.R = m.err(pred.xgboost.r)
t(err)
# Addestramento del modello finale con i parametri migliori
cat("\nAddestramento del modello finale con i parametri migliori...\n")
m.lgb.r <- lgb.train(
